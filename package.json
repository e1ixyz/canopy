{
  "name": "orchestrator",
  "productName": "Orchestrator",
  "version": "0.1.0",
  "description": "Multi-session Claude Code harness with worktrees, a session bus and live previews",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w node-pty",
    "package": "electron-vite build && electron-builder --mac --dir",
    "postinstall": "electron-rebuild -f -w node-pty",
    "app": "electron-vite build && electron-vite preview",
    "install-app": "./scripts/install-app.sh",
    "dist": "./scripts/dist.sh"
  },
  "trustedDependencies": [
    "electron",
    "node-pty",
    "esbuild"
  ],
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7",
    "vitest": "^4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.50.0",
    "motion": "^14.0.0",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
